<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/frameLayout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/buttonMorning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/holo_blue_bright"
            android:onClick="btnMorningClick"
            android:text="@string/button_morning"
            android:textColor="@android:color/background_light"
            android:textSize="16sp"
            tools:ignore="TextContrastCheck" />

        <Button
            android:id="@+id/buttonDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/holo_blue_bright"
            android:onClick="btnDayClick"
            android:text="@string/button_day"
            android:textColor="@android:color/background_light"
            android:textSize="16sp"
            tools:ignore="TextContrastCheck" />

        <Button
            android:id="@+id/buttonEvening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/holo_blue_bright"
            android:onClick="btnEveningClick"
            android:text="@string/button_evening"
            android:textColor="@android:color/background_light"
            android:textSize="16sp"
            tools:ignore="TextContrastCheck" />

        <Button
            android:id="@+id/buttonNight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/holo_blue_bright"
            android:onClick="btnNightClick"
            android:text="@string/button_night"
            android:textColor="@android:color/background_light"
            android:textSize="16sp"
            tools:ignore="TextContrastCheck" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="800dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMorning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <ImageView
                android:id="@+id/imageMorning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:srcCompat="@drawable/morning" />



        </androidx.constraintlayout.widget.ConstraintLayout>
        <Button
            android:id="@+id/buttonNoseMorning"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="120dp"
            android:layout_marginTop="348dp"
            android:background="@android:color/transparent"
            android:onClick="btnNoseClick"
            android:text="Button1"
            app:layout_constraintStart_toStartOf="@+id/imageMorning"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/buttonNoseDay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="192dp"
            android:layout_marginTop="340dp"
            android:background="@android:color/transparent"
            android:onClick="btnNoseClick"
            android:text="Button1"
            app:layout_constraintStart_toStartOf="@+id/imageMorning"
            app:layout_constraintTop_toTopOf="parent" />
        <Button
            android:id="@+id/buttonNoseEvening"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="148dp"
            android:layout_marginTop="408dp"
            android:background="@android:color/transparent"
            android:onClick="btnNoseClick"
            android:text="Button1"
            app:layout_constraintStart_toStartOf="@+id/imageMorning"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/buttonNoseNight"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="192dp"
            android:layout_marginTop="492dp"
            android:background="@android:color/transparent"
            android:onClick="btnNoseClick"
            android:text="Button1"
            app:layout_constraintStart_toStartOf="@+id/imageMorning"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginVertical="750dp"
            android:layout_marginStart="120dp"
            android:text="Нажми мне на нос"
            android:textSize="18sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:srcCompat="@drawable/day" />

        <ImageView
            android:id="@+id/imageEvening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:srcCompat="@drawable/evening" />

        <ImageView
            android:id="@+id/imageNight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:srcCompat="@drawable/night" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>