<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageMap"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:src="@drawable/map1"
            android:layout_centerInParent="true" />

        <ImageView
            android:id="@+id/imageDial"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:src="@drawable/apps"
            android:layout_centerInParent="true"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/imageMail"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:src="@drawable/mail1"
            android:layout_centerInParent="true"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/imageInfo"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:src="@drawable/info1"
            android:layout_centerInParent="true"
            android:visibility="gone"/>
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            app:itemBackground="@color/material_dynamic_tertiary70"
            app:itemIconTint="@animator/bottom_navigation_item_background_colors"
            app:itemTextColor="@animator/bottom_navigation_item_background_colors"
            app:menu="@menu/menu_bottom_navigation" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>